<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/view_icon_square"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_hollow_square" />

        <TextView
            android:id="@+id/btn_icon_color_picker"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_color_badge"
            android:text="🎨"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_app_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:fontFamily="@font/vazirmatn" />

</LinearLayout>
